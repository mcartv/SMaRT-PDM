SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_KEY=your-service-role-key
DATABASE_URL=postgresql://runtime-user:password@host:5432/postgres
# Preferred DDL-capable connection. When absent, startup temporarily falls back
# to DATABASE_URL and still verifies the canonical schema before listening.
MIGRATION_DATABASE_URL=postgresql://migration-user:password@host:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN_SUFFIXES=.vercel.app
STUDENT_BACKEND_BASE_URL=http://127.0.0.1:3000
INTERNAL_NOTIFICATION_SECRET=replace-with-the-same-shared-secret

# Birth OCR V2 only. Gemini runs in the backend; never put this key on the Pi.
GEMINI_API_KEY=replace-with-a-new-backend-only-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_DIAGNOSTIC_TIMEOUT_MS=90000
IOT_OCR_CAPTURE_BUCKET=iot-ocr-captures
