'use strict';

const auditLogService = require('../services/auditLogService');

const METHODS = new Set(['POST', 'PUT', 'PATCH', 'DELETE']);
const EXCLUDED = [
  '/api/audit-logs',
  '/api/auth/session/check',
  '/api/auth/session/resume',
  '/api/health',
];
const QUIET = [
  /\/notifications\/(?:read|read-all|seen)(?:\/|$)/i,
  /\/messages\/(?:typing|presence)(?:\/|$)/i,
];
const MODULES = [
  [/^\/api\/applications(?:\/|$)/i, 'Applications'],
  [/^\/api\/endorsement/i, 'Endorsements'],
  [/^\/api\/scholars?(?:\/|$)/i, 'Scholars'],
  [/^\/api\/renewals?(?:\/|$)/i, 'Renewals'],
  [/^\/api\/payouts?(?:\/|$)/i, 'Payout'],
  [/^\/api\/ro(?:\/|-|$)/i, 'Obligations / RO'],
  [/^\/api\/(?:program-)?openings?(?:\/|$)/i, 'Openings'],
  [/^\/api\/announcements?(?:\/|$)/i, 'Announcements'],
  [/^\/api\/profile-photos?(?:\/|$)/i, 'Profile Photos'],
  [/^\/api\/student-registry(?:\/|$)/i, 'Student Registry'],
  [/^\/api\/accounts?(?:\/|$)/i, 'Accounts'],
  [/^\/api\/(?:benefactors?|scholarship-program)(?:\/|$)/i, 'Scholarship Programs'],
  [/^\/api\/academic-years?(?:\/|$)/i, 'Academic Years'],
  [/^\/api\/courses?(?:\/|$)/i, 'Courses'],
  [/^\/api\/(?:theme-settings?|general-settings?)(?:\/|$)/i, 'Settings'],
  [/^\/api\/(?:ocr|pi)(?:\/|-|$)/i, 'OCR'],
  [/^\/api\/reports?(?:\/|$)/i, 'Reports'],
  [/^\/api\/auth(?:\/|$)/i, 'Authentication'],
];

function pathOf(req) {
  return String(req.originalUrl || req.url || '').split('?')[0].replace(/\/+/g, '/');
}
function moduleOf(pathname) {
  return MODULES.find(([rx]) => rx.test(pathname))?.[1] || 'System';
}
function slug(value) {
  return String(value || 'system').replace(/[^a-z0-9]+/gi, '_').replace(/^_+|_+$/g, '').toLowerCase();
}
function actionOf(method, pathname, moduleName) {
  const p=pathname.toLowerCase();
  const keys=[
    ['request-reupload','REQUEST_REUPLOAD'],['reupload','REQUEST_REUPLOAD'],
    ['approve','APPROVE'],['activate','ACTIVATE'],['verify','VERIFY'],
    ['confirm','CONFIRM'],['reject','REJECT'],['archive','ARCHIVE'],
    ['restore','RESTORE'],['close','CLOSE'],['cancel','CANCEL'],
    ['rescan','RESCAN'],['retry','RETRY'],['upload','UPLOAD'],
    ['import','IMPORT'],['publish','PUBLISH'],['assign','ASSIGN'],
    ['complete','COMPLETE'],['submit','SUBMIT'],['password','CHANGE_PASSWORD'],
  ];
  const hit=keys.find(([needle])=>p.includes(needle));
  if(hit) return `${hit[1]}_${slug(moduleName).toUpperCase()}`;
  if(method==='POST') return `CREATE_${slug(moduleName).toUpperCase()}`;
  if(method==='DELETE') return `DELETE_${slug(moduleName).toUpperCase()}`;
  return `UPDATE_${slug(moduleName).toUpperCase()}`;
}
function entityIdOf(pathname) {
  const parts=pathname.split('/').filter(Boolean).reverse();
  return parts.find(v=>/^[0-9a-f]{8}-[0-9a-f-]{27,}$/i.test(v)||/^\d+$/.test(v)||/^PDM-/i.test(v))||null;
}

module.exports = function systemAuditCoverageMiddleware(req,res,next) {
  const method=String(req.method||'').toUpperCase();
  const pathname=pathOf(req);
  if(!METHODS.has(method)) return next();
  if(EXCLUDED.some(prefix=>pathname.startsWith(prefix))) return next();
  if(QUIET.some(rx=>rx.test(pathname))) return next();

  res.once('finish',()=>{
    if(res.statusCode<200||res.statusCode>=400) return;
    if(req.__systemAuditLogged===true) return;

    const moduleName=moduleOf(pathname);
    setImmediate(()=>{
      auditLogService.logAudit({
        req,
        actionTaken: actionOf(method,pathname,moduleName),
        module: moduleName,
        entityType: slug(moduleName),
        entityId: entityIdOf(pathname),
        description: `${moduleName} mutation completed successfully.`,
        metadata: {
          method,
          path: pathname,
          status_code: res.statusCode,
          audit_source: 'automatic_mutation_fallback',
        },
      }).catch(error=>console.error('SYSTEM AUDIT FALLBACK ERROR:',error.message));
    });
  });
  return next();
};
