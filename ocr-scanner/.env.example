RENDER_API_BASE_URL=https://your-admin-backend.example.com
PI_SHARED_TOKEN=replace-with-the-same-backend-shared-token
# Optional. Must be a UUID. When omitted, api.py derives a stable UUID from
# the Raspberry Pi machine identity.
IOT_DEVICE_ID=2e4e1e90-3d8a-4c59-b1ef-b7ae8a8d2b11
HTTP_TIMEOUT_SECONDS=60
POLL_INTERVAL_SECONDS=1
IOT_OCR_HEARTBEAT_INTERVAL_SECONDS=0.50
IOT_OCR_STOPPED_DISPLAY_SECONDS=1.25
SMART_PDM_GUI_STATE_INTERVAL_SECONDS=0.25
# Grade Forms and Birth Certificates use lens position 2.00. Indigency and
# other document pipelines retain 1.50. Preview and capture use one position.
GRADE_FORM_LENS_POSITION=2.00
BIRTH_CERTIFICATE_LENS_POSITION=2.00
# Birth-only deterministic still capture. Grade Form, Indigency, and other
# document profiles continue using their existing camera defaults.
BIRTH_CAMERA_CAPTURE_WIDTH=4608
BIRTH_CAMERA_CAPTURE_HEIGHT=2592
BIRTH_CAMERA_EXPOSURE_TIME_US=20000
BIRTH_CAMERA_ANALOGUE_GAIN=1.0
BIRTH_CAMERA_BRIGHTNESS=0.1
BIRTH_CAMERA_CONTRAST=1.2
# PaddleOCR downloads the Birth-only English PP-OCRv5 mobile recognition model
# on first use and runs it with ONNX Runtime on the Pi CPU.
# BOS is more reliable than Hugging Face on restricted Pi networks.
PADDLE_PDX_MODEL_SOURCE=BOS
CAMERA_CAPTURE_ROI=0.08,0.08,0.84,0.84
CAMERA_FIXED_CAPTURE_TIMEOUT_MS=650
LOG_LEVEL=INFO
