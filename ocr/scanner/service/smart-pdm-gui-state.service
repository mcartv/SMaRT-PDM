[Unit]
Description=SMaRT-PDM GUI State Compatibility Writer

[Service]
Type=simple
WorkingDirectory=/home/smart_pdm/birth-certificate-acceptance/ocr/scanner
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=%t
Environment=SMART_PDM_OCR_STATE_PATH=%t/smart_pdm/ocr_state.json
ExecStart=/usr/bin/python3 -u /home/smart_pdm/birth-certificate-acceptance/ocr/scanner/service/active_worker_gui_state.py
Restart=always
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=default.target
