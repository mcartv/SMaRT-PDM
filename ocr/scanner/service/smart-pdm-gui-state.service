[Unit]
Description=SMaRT-PDM Pi Device State Monitor
StartLimitIntervalSec=60
StartLimitBurst=12

[Service]
Type=simple
WorkingDirectory=/home/smart_pdm/birth-certificate-acceptance/ocr/scanner
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=%t
Environment=SMART_PDM_RUNTIME_DIRECTORY=%t/smart_pdm
Environment=SMART_PDM_DEVICE_STATE_PATH=%t/smart_pdm/device_state.json
Environment=SMART_PDM_OCR_ACTIVITY_PATH=%t/smart_pdm/worker_activity.json
ExecStart=/usr/bin/python3 -u /home/smart_pdm/birth-certificate-acceptance/ocr/scanner/service/active_worker_gui_state.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
